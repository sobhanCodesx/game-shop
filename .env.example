APP_NAME="NEXUS PLAY"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

ADMIN_EMAIL=
ADMIN_PASSWORD=

PAYAMAK_PANEL_USERNAME=
PAYAMAK_PANEL_API_KEY=
PAYAMAK_PANEL_FROM=
PAYAMAK_PANEL_FROM_SUPPORT_ONE=
PAYAMAK_PANEL_FROM_SUPPORT_TWO=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inertia
DB_USERNAME=root
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
DOWNLOAD_URL=https://cdn.example.com/storage
DOWNLOAD_FTP_HOST=ftp.example.com
DOWNLOAD_FTP_PORT=21
DOWNLOAD_FTP_USERNAME=
DOWNLOAD_FTP_PASSWORD=
DOWNLOAD_FTP_ROOT=storage
DOWNLOAD_FTP_SSL=false
FFMPEG_BINARY=
FFMPEG_PRESET=veryfast
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# اطلاعات سرویس SMTP ایمیل را اینجا وارد کنید.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Deployment packages are disabled by default. Use the same random signing key
# on the trusted build machine and production server.
DEPLOY_EXPORT_ENABLED=false
DEPLOY_IMPORT_ENABLED=false
DEPLOYMENT_APP_ID=
DEPLOYMENT_SIGNING_KEY=
# Optional on Local Windows when Composer is not discoverable automatically.
DEPLOYMENT_COMPOSER_PHAR=
DEPLOYMENT_MAX_PACKAGE_SIZE=536870912
DEPLOYMENT_MAX_ENTRIES=30000
DEPLOYMENT_MAX_EXTRACTED_SIZE=1610612736
DEPLOYMENT_MAX_COMPRESSION_RATIO=100
DEPLOYMENT_RETENTION=3
