APP_NAME="NEXUS PLAY"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google OAuth (only OpenID profile/email scopes are requested).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Native Google Sign-In audience ids used by the PlayNexus mobile API.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Versioned native mobile API.
MOBILE_API_TOKEN_TTL_DAYS=180
MOBILE_API_TOKEN_NAME="PlayNexus Mobile"
MOBILE_API_MIN_APP_VERSION=1.0.0
MOBILE_API_CURRENT_APP_VERSION=1.0.0

PAYAMAK_PANEL_USERNAME=
PAYAMAK_PANEL_API_KEY=
PAYAMAK_PANEL_FROM=
PAYAMAK_PANEL_FROM_SUPPORT_ONE=
PAYAMAK_PANEL_FROM_SUPPORT_TWO=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inertia
DB_USERNAME=root
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Session lifetime is fixed to two weeks (20,160 minutes) in config/session.php.
SESSION_LIFETIME=20160
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
DOWNLOAD_URL=https://cdn.example.com/storage
DOWNLOAD_FTP_HOST=ftp.example.com
DOWNLOAD_FTP_PORT=21
DOWNLOAD_FTP_USERNAME=
DOWNLOAD_FTP_PASSWORD=
DOWNLOAD_FTP_ROOT=storage
DOWNLOAD_FTP_SSL=false
QUEUE_CONNECTION=database
# Optional absolute PHP CLI path used by the System Console when generating Cron lines.
# Leave empty to auto-detect. Example on cPanel: /usr/local/bin/php
SCHEDULER_PHP_BINARY=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# اطلاعات سرویس SMTP ایمیل را اینجا وارد کنید.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Inertia SSR runs as a private Node.js service. Rendering is additionally
# restricted to the allowlist in config/inertia.php.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_RUNTIME=node
INERTIA_SSR_ENSURE_RUNTIME_EXISTS=true
INERTIA_SSR_PORT=13714
# Optional when Laravel reaches SSR through Passenger/reverse proxy.
# When omitted, Laravel uses http://127.0.0.1:${INERTIA_SSR_PORT}.
# Production example: https://playnexus.ir/__inertia_ssr
# INERTIA_SSR_URL=
INERTIA_SSR_ENSURE_BUNDLE_EXISTS=true
INERTIA_SSR_THROW_ON_ERROR=false
# When deployment finishes, copy the standalone bundle to the Passenger app
# and touch its standard restart marker only when the bundle changed.
INERTIA_SSR_PASSENGER_BUNDLE_PATH=/home/zsjqcwee/inertia-ssr/ssr.js
INERTIA_SSR_PASSENGER_RESTART_FILE=/home/zsjqcwee/inertia-ssr/tmp/restart.txt

# Mobile push. Android devices register their native FCM token directly.
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
# Keep the Firebase service-account JSON outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# Optional: when omitted, project_id is read from the service-account JSON.
FIREBASE_PROJECT_ID=

# PlayNexus MCP / GraphQL / deployment agent. Never commit the real token.
# The same existing token authenticates HTTPS production deployment; no second deploy secret is needed.
PLAYNEXUS_CONTENT_AGENT_TOKEN=
# Existing admin user id used as the author of AI-created content drafts.
PLAYNEXUS_CONTENT_AGENT_AUTHOR_USER_ID=
# Public/active/published transitions are blocked unless this is explicitly enabled.
PLAYNEXUS_CONTENT_AGENT_ALLOW_PUBLISH=false
# Delete/restore operations are blocked unless this is explicitly enabled.
PLAYNEXUS_CONTENT_AGENT_ALLOW_DESTRUCTIVE=false
# Binary media/file uploads use the same MCP bearer token; no second token is needed.
PLAYNEXUS_CONTENT_AGENT_ALLOW_UPLOADS=false
# 300 MB total upload limit, 2 MB per JSON-RPC chunk, 24-hour temp-session TTL.
PLAYNEXUS_CONTENT_AGENT_MAX_UPLOAD_SIZE=314572800
PLAYNEXUS_CONTENT_AGENT_MAX_CHUNK_SIZE=2097152
PLAYNEXUS_CONTENT_AGENT_UPLOAD_TTL=86400

# Private read-only Intelligence Graph used by the AI/MCP. It uses the same Bearer token.
PLAYNEXUS_CONTENT_AGENT_GRAPHQL_ENABLED=true
PLAYNEXUS_CONTENT_AGENT_GRAPHQL_INTROSPECTION=true
PLAYNEXUS_CONTENT_AGENT_GRAPHQL_MAX_QUERY_BYTES=24000
PLAYNEXUS_CONTENT_AGENT_GRAPHQL_MAX_VARIABLES_BYTES=48000
PLAYNEXUS_CONTENT_AGENT_GRAPHQL_MAX_RESPONSE_BYTES=2097152
PLAYNEXUS_CONTENT_AGENT_GRAPHQL_MAX_DEPTH=10
PLAYNEXUS_CONTENT_AGENT_GRAPHQL_MAX_INTROSPECTION_DEPTH=16
PLAYNEXUS_CONTENT_AGENT_GRAPHQL_MAX_COMPLEXITY=500
PLAYNEXUS_CONTENT_AGENT_GRAPHQL_MAX_FIELDS=250
PLAYNEXUS_CONTENT_AGENT_GRAPHQL_MAX_PAGE_SIZE=50
PLAYNEXUS_CONTENT_AGENT_GRAPHQL_MAX_OFFSET=10000
